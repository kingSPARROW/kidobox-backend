APP_NAME=HomZy
APP_ENV=local
APP_KEY=base64:homzycommercekeyplaceholder1234567890123456=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- PRIMARY PERSISTENCE: MONGODB REPLICA SET ---
DB_CONNECTION=mongodb
DB_HOST=127.0.0.1
DB_PORT=27017
DB_DATABASE=homzy_db
DB_USERNAME=
DB_PASSWORD=
DB_OPTIONS="replicaSet=rs0&readPreference=primaryPreferred"

SESSION_DRIVER=cookie
SESSION_LIFETIME=120

QUEUE_CONNECTION=sync
CACHE_STORE=file
FILESYSTEM_DISK=local

# --- PAYMENT INTEGRATIONS (SANDBOX DEFAULTS) ---
RAZORPAY_KEY_ID=rzp_test_HomZyPlaceholderKey
RAZORPAY_KEY_SECRET=rzp_secret_HomZyPlaceholderSecret
RAZORPAY_WEBHOOK_SECRET=

CASHFREE_APP_ID=TEST_CF_APP_ID
CASHFREE_SECRET_KEY=TEST_CF_SECRET_KEY
CASHFREE_ENV=sandbox

# --- SHIPPING INTEGRATIONS ---
SHIPROCKET_EMAIL=sandbox@shiprocket.in
SHIPROCKET_PASSWORD=sandbox_password
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
